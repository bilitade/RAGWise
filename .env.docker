# =============================================================================
# Docker environment — copy this file and fill in real values before running.
#
#   cp .env.docker .env.docker.local
#   # edit .env.docker.local
#   docker compose --env-file .env.docker.local up --build
#
# Values that reference other Docker services (postgres / redis / qdrant)
# are already set correctly — do not change the hostnames.
# =============================================================================

# ── Postgres credentials (must match docker-compose.yml POSTGRES_* vars) ─────
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass

# ── LLM / Search API keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# ── LangSmith (optional tracing) ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ragwise
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# ── Security ──────────────────────────────────────────────────────────────────
# These are pre-generated test secrets — regenerate for every real deployment:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=3b1473da085538e30466fddcb36a153f831640f1b4b057e341bdc9c4268b9f90
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SETTINGS_SECRET_KEY=06b43e09e0c7244bdfba25d7b762cc9e6b7ae514e40986b435f22d96236171f0

# ── Initial admin account ─────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
REQUIRE_AUTH=true
ALLOW_ANONYMOUS_CHAT=false
COMPANY_NAME=

# ── Rate limits (requests / minute) ──────────────────────────────────────────
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_AUTH_PUBLIC_PER_MINUTE=12
RATE_LIMIT_CHAT_STREAM_PER_MINUTE=40
RATE_LIMIT_ADMIN_PER_MINUTE=999999

# ── Public URL (used in password-reset emails) ────────────────────────────────
PUBLIC_APP_URL=http://localhost

# ── SMTP (optional — password reset emails) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_COLLECTION=knowledge_base
QDRANT_TIMEOUT=10.0
QDRANT_HYBRID_ENABLED=true
QDRANT_SPARSE_MODEL=prithivida/Splade_PP_en_v1
QDRANT_DENSE_VECTOR_NAME=dense-vector
QDRANT_SPARSE_VECTOR_NAME=sparse-vector
QDRANT_SPARSE_USE_IDF=true
QDRANT_HNSW_M=24
QDRANT_HNSW_PAYLOAD_M=24
QDRANT_HNSW_EF_CONSTRUCT=256
QDRANT_HNSW_FULL_SCAN_THRESHOLD_KB=0
QDRANT_QUERY_HNSW_EF=128
QDRANT_DENSE_ON_DISK=false
QDRANT_SPARSE_ON_DISK=true
QDRANT_SPARSE_FULL_SCAN_THRESHOLD=0
QDRANT_DENSE_DATATYPE=float32
QDRANT_HYBRID_ALPHA=0.6

# ── Models ────────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=
MODEL_PROVIDER=openai
INGEST_CHUNK_SIZE=512
INGEST_CHUNK_OVERLAP=64
CHUNK_SIZE_MIN=128
CHUNK_SIZE_MAX=4096

# ── Provider base URLs (defaults; Admin UI can override) ──────────────────────
GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_OPENAI_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_OPENAI_BASE_URL=https://router.huggingface.co/v1
NVIDIA_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
