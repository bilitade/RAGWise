# =============================================================================
# Copy to project root as `.env` (same folder as `pyproject.toml`).
# `app.config` only loads `.env` from the repo root — not from `frontend/`.
#
# Run Python tooling from the repo root, e.g.:
#   uv run ruff check app tests
#   uv run pytest -q
# Or: make lint && make test
# =============================================================================

# --- LLM API keys (optional unless you use that provider) ---
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Hugging Face: HF_TOKEN or HUGGINGFACE_API_KEY (see runtime_config loaders)
HF_TOKEN=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=your_tavily_api_key

# --- LangSmith ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=rag-deep-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# --- Database & auth ---
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag_deep_agent
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SETTINGS_SECRET_KEY=
REQUIRE_AUTH=true
# development | test | production — production enforces strong JWT_SECRET / SETTINGS_SECRET_KEY
APP_ENV=development
# If false, chat streaming requires a logged-in user even when REQUIRE_AUTH is off (demo hardening).
ALLOW_ANONYMOUS_CHAT=false
# Per-route rate limits (requests per minute; raise for local load tests).
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_AUTH_PUBLIC_PER_MINUTE=12
RATE_LIMIT_CHAT_STREAM_PER_MINUTE=40
# Admin JWTs use this bucket (default is effectively unlimited for normal workloads).
RATE_LIMIT_ADMIN_PER_MINUTE=999999
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- SMTP (password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
QDRANT_TIMEOUT=10.0
QDRANT_HYBRID_ENABLED=true
QDRANT_SPARSE_MODEL=prithivida/Splade_PP_en_v1
QDRANT_DENSE_VECTOR_NAME=dense-vector
QDRANT_SPARSE_VECTOR_NAME=sparse-vector
QDRANT_SPARSE_USE_IDF=true
QDRANT_HNSW_M=24
QDRANT_HNSW_PAYLOAD_M=24
QDRANT_HNSW_EF_CONSTRUCT=256
QDRANT_HNSW_FULL_SCAN_THRESHOLD_KB=0
QDRANT_QUERY_HNSW_EF=128
QDRANT_DENSE_ON_DISK=false
QDRANT_SPARSE_ON_DISK=true
QDRANT_SPARSE_FULL_SCAN_THRESHOLD=0
QDRANT_DENSE_DATATYPE=float32
QDRANT_HYBRID_ALPHA=0.6

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Default models & provider (Admin / app_settings can override many of these) ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=
RAGAS_EVAL_MODEL=
MODEL_PROVIDER=openai
INGEST_CHUNK_SIZE=512
INGEST_CHUNK_OVERLAP=64
CHUNK_SIZE_MIN=128
CHUNK_SIZE_MAX=4096

# OpenAI-compatible chat API roots (defaults; Admin can persist overrides in app_settings)
GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_OPENAI_BASE_URL=https://openrouter.ai/api/v1
HUGGINGFACE_OPENAI_BASE_URL=https://router.huggingface.co/v1
NVIDIA_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Paths & misc ---
DOCUMENTS_DIR=
# Override JSON document registry (default: app/db/{QDRANT_COLLECTION}_documents.json)
DOCUMENT_REGISTRY_PATH=
COMPANY_NAME=
APP_LOG_FILE=
